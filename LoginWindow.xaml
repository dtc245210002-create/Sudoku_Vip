<Window x:Class="sudokuvip.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sudoku VIP - Đăng nhập &amp; Tài khoản" 
        Height="630" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#121212"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Style cho TextBox & PasswordBox -->
        <Style x:Key="InputBoxStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style cho Nút Bấm Chính -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Tab -->
        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Style cho Nút Avatar -->
        <Style x:Key="AvatarBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12" Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- 3 Tabs -->
                    <RowDefinition Height="*"/>    <!-- Nội dung chính -->
                </Grid.RowDefinitions>

                <!-- 1. Header Logo & Tiêu đề -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🧩 SUDOKU VIP" FontSize="22" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cơ sở dữ liệu người chơi &amp; Thành tích trực tuyến" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 2. Tab Bar: 3 Tabs (Đăng nhập, Tạo tài khoản, Chơi khách) -->
                <Border Grid.Row="1" Background="#141414" CornerRadius="8" Padding="3" Margin="0,0,0,12">
                    <UniformGrid Rows="1" Columns="3">
                        <Button x:Name="btnTabLogin" Content="Đăng nhập" Style="{StaticResource TabBtnStyle}" Foreground="#60A5FA" Click="BtnTabLogin_Click"/>
                        <Button x:Name="btnTabRegister" Content="Tạo tài khoản" Style="{StaticResource TabBtnStyle}" Click="BtnTabRegister_Click"/>
                        <Button x:Name="btnTabGuest" Content="Chơi khách" Style="{StaticResource TabBtnStyle}" Click="BtnTabGuest_Click"/>
                    </UniformGrid>
                </Border>

                <!-- 3. Khu vực Nội dung 3 Tab -->
                <Grid Grid.Row="2">
                    <!-- ================= TAB 1: ĐĂNG NHẬP ================= -->
                    <StackPanel x:Name="panelLogin" Visibility="Visible">
                        <TextBlock Text="Tên đăng nhập:" FontSize="13" Foreground="#AAAAAA" Margin="0,5,0,4"/>
                        <TextBox x:Name="txtLoginUser" Style="{StaticResource InputBoxStyle}" KeyDown="Input_KeyDown"/>

                        <TextBlock Text="Mật khẩu:" FontSize="13" Foreground="#AAAAAA" Margin="0,12,0,4"/>
                        <Grid>
                            <PasswordBox x:Name="txtLoginPass" Style="{StaticResource InputBoxStyle}" Padding="10,0,38,0" KeyDown="Input_KeyDown"/>
                            <TextBox x:Name="txtLoginPassVisible" Style="{StaticResource InputBoxStyle}" Padding="10,0,38,0" Visibility="Collapsed" KeyDown="Input_KeyDown"/>
                            <Button x:Name="btnToggleLoginPass" Content="👁️" Width="32" Height="32" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" Click="BtnToggleLoginPass_Click"/>
                        </Grid>

                        <TextBlock x:Name="lblLoginMessage" Text="" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>

                        <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Style="{StaticResource PrimaryBtnStyle}" Margin="0,20,0,0" Click="BtnLogin_Click"/>
                    </StackPanel>

                    <!-- ================= TAB 2: TẠO TÀI KHOẢN MỚI ================= -->
                    <ScrollViewer x:Name="panelRegister" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Chọn Avatar -->
                            <TextBlock Text="Chọn biểu tượng Avatar:" FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="wpAvatars" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Button Content="👤" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🦊" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🦁" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🐼" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🚀" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="⚡" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="👑" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🎯" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🔥" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                                <Button Content="🏆" Style="{StaticResource AvatarBtnStyle}" Click="Avatar_Click"/>
                            </WrapPanel>

                            <!-- Tên đăng nhập -->
                            <TextBlock Text="Tên đăng nhập (chữ và số):" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtRegUser" Style="{StaticResource InputBoxStyle}" KeyDown="Input_KeyDown" TextChanged="TxtRegUser_TextChanged"/>
                            <TextBlock x:Name="lblUserCheck" Text="" FontSize="11" Margin="0,2,0,4"/>

                            <!-- Tên hiển thị -->
                            <TextBlock Text="Tên hiển thị người chơi:" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,3"/>
                            <TextBox x:Name="txtRegDisplayName" Style="{StaticResource InputBoxStyle}" KeyDown="Input_KeyDown"/>

                            <!-- Mật khẩu -->
                            <TextBlock Text="Mật khẩu:" FontSize="12" Foreground="#AAAAAA" Margin="0,6,0,3"/>
                            <Grid>
                                <PasswordBox x:Name="txtRegPass" Style="{StaticResource InputBoxStyle}" Padding="10,0,38,0" KeyDown="Input_KeyDown" PasswordChanged="TxtRegPass_PasswordChanged"/>
                                <TextBox x:Name="txtRegPassVisible" Style="{StaticResource InputBoxStyle}" Padding="10,0,38,0" Visibility="Collapsed" KeyDown="Input_KeyDown" TextChanged="TxtRegPassVisible_TextChanged"/>
                                <Button x:Name="btnToggleRegPass" Content="👁️" Width="32" Height="32" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" Click="BtnToggleRegPass_Click"/>
                            </Grid>

                            <!-- Độ mạnh mật khẩu -->
                            <Grid Margin="0,4,0,4">
                                <ProgressBar x:Name="pbPassStrength" Height="4" Background="#262626" Foreground="#10B981" Value="0" Maximum="100"/>
                            </Grid>
                            <TextBlock x:Name="lblPassStrength" Text="" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>

                            <!-- Nhập lại mật khẩu -->
                            <TextBlock Text="Nhập lại mật khẩu:" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,3"/>
                            <PasswordBox x:Name="txtRegConfirmPass" Style="{StaticResource InputBoxStyle}" KeyDown="Input_KeyDown"/>

                            <!-- Di chuyển dữ liệu khách -->
                            <CheckBox x:Name="chkMigrateGuest" Content="Chuyển điểm và lịch sử từ phiên Khách sang tài khoản này" Foreground="#60A5FA" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

                            <TextBlock x:Name="lblRegMessage" Text="" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" HorizontalAlignment="Center"/>

                            <Button x:Name="btnRegister" Content="TẠO TÀI KHOẢN MỚI" Style="{StaticResource PrimaryBtnStyle}" Background="#10B981" Margin="0,10,0,10" Click="BtnRegister_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= TAB 3: CHƠI KHÁCH ================= -->
                    <StackPanel x:Name="panelGuest" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🎮 THIẾT LẬP CHƠI KHÁCH" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Bạn có thể chơi ngay lập tức mà không cần tài khoản. Toàn bộ điểm số trong phiên sẽ được giữ lại nếu bạn quyết định đăng ký sau!" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>

                                <!-- Chọn Avatar Khách -->
                                <TextBlock Text="Biểu tượng của bạn:" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                <WrapPanel x:Name="wpGuestAvatars" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="👤" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                    <Button Content="🦊" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                    <Button Content="🐼" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                    <Button Content="🦁" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                    <Button Content="🚀" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                    <Button Content="⚡" Style="{StaticResource AvatarBtnStyle}" Click="GuestAvatar_Click"/>
                                </WrapPanel>

                                <!-- Biệt danh khách -->
                                <TextBlock Text="Biệt danh (tùy chọn):" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txtGuestNickname" Style="{StaticResource InputBoxStyle}" KeyDown="Input_KeyDown"/>
                                    <Button Grid.Column="1" x:Name="btnRandomGuestName" Content="🎲 Đổi tên" Background="#262626" Foreground="#E0E0E0" BorderThickness="0" Margin="6,0,0,0" Padding="10,0" Cursor="Hand" Click="BtnRandomGuestName_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnConfirmGuest" Content="BẮT ĐẦU CHƠI NGAY (KHÁCH)" Style="{StaticResource PrimaryBtnStyle}" Background="#F59E0B" Click="BtnConfirmGuest_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
