<Window x:Class="sudokuvip.Pvp.Views.PvpArenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sudoku VIP - Đấu Trường PvP" Height="740" Width="1100"
        Background="#121212" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Focusable="True">

    <Window.Resources>
        <!-- Style bàn phím số -->
        <Style x:Key="NumPadBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#5B93E8"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút chức năng (Undo, Erase, Pencil) -->
        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút Emote -->
        <Style x:Key="EmoteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,10,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. THANH HEADER ĐỐI KHÁNG (VS HEADER & TUG-OF-WAR BAR) -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Phe Ta (Bên trái - Xanh dương) -->
                <Grid Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1.5" Margin="0,0,10,0">
                            <TextBlock x:Name="txtP1Avatar" Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtP1Name" Text="Bạn" Foreground="#60A5FA" FontWeight="Bold" FontSize="15" Margin="0,0,8,0"/>
                                <Border Background="#1E3A8A" CornerRadius="4" Padding="5,1">
                                    <TextBlock x:Name="txtP1Elo" Text="1250 Elo" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Mạng: " Foreground="#9CA3AF" FontSize="12"/>
                                <TextBlock x:Name="txtP1Hearts" Text="❤️❤️❤️" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="Giải: " Foreground="#9CA3AF" FontSize="12"/>
                                <TextBlock x:Name="txtP1ProgressText" Text="0/50" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- Floating Emote P1 -->
                    <TextBlock x:Name="txtP1FloatingEmote" Text="👋" FontSize="32" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,-20,0,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="transP1Emote"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <!-- Khu vực trung tâm: Tug-of-war Bar & Timer -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="txtP1Pct" Text="0%" Foreground="#60A5FA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                        <Border Background="#262626" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="8,1" HorizontalAlignment="Center">
                            <TextBlock Text="⚔️ VS" Foreground="#FBBF24" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="txtP2Pct" Text="0%" Foreground="#F87171" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Dual Tug-of-war Progress Bar -->
                    <Border Background="#262626" Height="14" CornerRadius="7" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="colP1Bar" Width="*"/>
                                <ColumnDefinition x:Name="colP2Bar" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#3B82F6"/>
                            <Border Grid.Column="1" Background="#EF4444"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="⏱️ " FontSize="12"/>
                        <TextBlock x:Name="txtTimer" Text="00:00" Foreground="#F3F4F6" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="txtDifficultyTag" Text=" | Độ khó: Dễ" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Đối thủ (Bên phải - Đỏ) -->
                <Grid Grid.Column="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="#7F1D1D" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtP2Elo" Text="1280 Elo" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="txtP2Name" Text="Đối thủ" Foreground="#F87171" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock Text="Giải: " Foreground="#9CA3AF" FontSize="12"/>
                                <TextBlock x:Name="txtP2ProgressText" Text="0/50" Foreground="#F87171" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="Mạng: " Foreground="#9CA3AF" FontSize="12"/>
                                <TextBlock x:Name="txtP2Hearts" Text="❤️❤️❤️" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1.5" Margin="10,0,0,0">
                            <TextBlock x:Name="txtP2Avatar" Text="🦊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <!-- Floating Emote P2 -->
                    <TextBlock x:Name="txtP2FloatingEmote" Text="😎" FontSize="32" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,50,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="transP2Emote"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. KHU VỰC THI ĐẤU CHÍNH (BÀN CỜ VÀ SIDEBAR) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- BÀN CỜ CHÍNH 9x9 CỦA BẠN (TRÁI) -->
            <Border Grid.Column="0" BorderBrush="#3B82F6" BorderThickness="2" Width="530" Height="530" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6">
                <UniformGrid x:Name="BoardGrid" Rows="9" Columns="9"/>
            </Border>

            <!-- SIDEBAR ĐIỀU KHIỂN & BÀN CỜ THU NHỎ ĐỐI THỦ (PHẢI) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                
                <!-- CARD 1: BÀN CỜ THU NHỎ CỦA ĐỐI THỦ (MINI-BOARD) -->
                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header mini board -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📡 Bàn cờ đối thủ" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="13"/>
                                <Border Background="#7F1D1D" CornerRadius="4" Padding="4,0" Margin="8,0,0,0">
                                    <TextBlock Text="LIVE" Foreground="#EF4444" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Ẩn đáp án" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Thân mini board: 9x9 Grid và Thống kê nhỏ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#333333" BorderThickness="1.5" Width="144" Height="144" Background="#111111" CornerRadius="4">
                                <UniformGrid x:Name="MiniBoardGrid" Rows="9" Columns="9"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Tình trạng đối thủ:" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="txtOppStatus" Text="🟢 Đang giải..." Foreground="#34D399" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,8"/>

                                <TextBlock Text="Số lỗi đối thủ:" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="txtOppMistakes" Text="0 / 3" Foreground="#F87171" FontWeight="Bold" FontSize="13" Margin="0,2,0,8"/>

                                <TextBlock Text="Điểm đối thủ:" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="txtOppScore" Text="0" Foreground="#FBBF24" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: CÔNG CỤ (UNDO, ERASE, PENCIL) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="btnUndo" Content="↺ Hoàn tác" Style="{StaticResource ToolBtnStyle}" ToolTip="Hoàn tác (U / Ctrl+Z)" Click="BtnUndo_Click"/>
                    <Button Grid.Column="1" x:Name="btnErase" Content="⌫ Xoá" Style="{StaticResource ToolBtnStyle}" ToolTip="Xoá ô (Delete / Backspace)" Click="BtnErase_Click"/>
                    <Button Grid.Column="2" x:Name="btnPencil" Content="✎ Ghi chú" Style="{StaticResource ToolBtnStyle}" ToolTip="Chế độ ghi chú (N)" Click="BtnPencil_Click"/>
                </Grid>

                <!-- CARD 3: BÀN PHÍM SỐ 3x3 -->
                <UniformGrid Rows="3" Columns="3" Margin="0,0,0,15">
                    <Button Content="1" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="2" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="3" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="4" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="5" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="6" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="7" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="8" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                    <Button Content="9" Style="{StaticResource NumPadBtnStyle}" Click="Number_Click"/>
                </UniformGrid>

                <!-- CARD 4: BIỂU CẢM NHANH (EMOTES) VÀ ĐẦU HÀNG -->
                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="8,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chat: " Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="👋" ToolTip="Chào" Style="{StaticResource EmoteBtnStyle}" Click="Emote_Click"/>
                            <Button Content="😎" ToolTip="Tự tin" Style="{StaticResource EmoteBtnStyle}" Click="Emote_Click"/>
                            <Button Content="😱" ToolTip="Choáng" Style="{StaticResource EmoteBtnStyle}" Click="Emote_Click"/>
                            <Button Content="🔥" ToolTip="Cháy" Style="{StaticResource EmoteBtnStyle}" Click="Emote_Click"/>
                            <Button Content="GG" ToolTip="Good Game" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" Style="{StaticResource EmoteBtnStyle}" Click="Emote_Click"/>
                        </StackPanel>

                        <Button x:Name="btnSurrender" Content="🏳️ Đầu hàng" Foreground="#EF4444" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Click="BtnSurrender_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
