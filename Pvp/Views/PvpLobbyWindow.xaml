<Window x:Class="sudokuvip.Pvp.Views.PvpLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sảnh Đấu Trường PvP" Height="600" Width="880"
        Background="#121212" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Style Tab Header -->
        <Style x:Key="LobbyTabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Card Nút Hành Động -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style radio chọn độ khó -->
        <Style x:Key="DiffRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER: TIÊU ĐỀ & THÔNG TIN NGƯỜI CHƠI -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚔️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="ĐẤU TRƯỜNG PVP TRỰC TUYẾN" Foreground="#F3F4F6" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Thi đấu đối kháng thời gian thực — Ai giải nhanh hơn sẽ thắng!" Foreground="#9CA3AF" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- Card Profile -->
            <Border HorizontalAlignment="Right" Background="#1A1A1A" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserAvatar" Text="👤" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="txtUserDisplayName" Text="Bạn" Foreground="#60A5FA" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="txtUserElo" Text="1250 Elo" Foreground="#FBBF24" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Background="#262626" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="txtUserWinRate" Text="Thắng: 0%" Foreground="#9CA3AF" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. TAB NAVIGATION -->
        <Border Grid.Row="1" BorderBrush="#262626" BorderThickness="0,0,0,1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabQuickMatch" Content="🔍 Tìm Trận Nhanh" Style="{StaticResource LobbyTabBtnStyle}" BorderBrush="#3B82F6" Foreground="#60A5FA" Click="BtnTabQuickMatch_Click"/>
                <Button x:Name="btnTabCustomRoom" Content="🏠 Phòng Riêng (PIN)" Style="{StaticResource LobbyTabBtnStyle}" Click="BtnTabCustomRoom_Click"/>
            </StackPanel>
        </Border>

        <!-- 3. NỘI DUNG CHÍNH (CONTENT AREA) -->
        <Grid Grid.Row="2">
            
            <!-- PANEL 1: TÌM TRẬN NHANH -->
            <Grid x:Name="panelQuickMatch" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Tùy chọn độ khó & Nút tìm trận -->
                <Border Grid.Column="0" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chọn Độ Khó Trận Đấu" Foreground="#F3F4F6" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <RadioButton x:Name="rbDiffEasy" Content="Dễ" IsChecked="True" Style="{StaticResource DiffRadioStyle}"/>
                            <RadioButton x:Name="rbDiffMedium" Content="Trung bình" Style="{StaticResource DiffRadioStyle}"/>
                            <RadioButton x:Name="rbDiffHard" Content="Khó" Style="{StaticResource DiffRadioStyle}"/>
                            <RadioButton x:Name="rbDiffExpert" Content="Chuyên gia" Style="{StaticResource DiffRadioStyle}"/>
                        </StackPanel>

                        <!-- Trạng thái tìm trận -->
                        <Border x:Name="borderSearching" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔄 Đang tìm đối thủ phù hợp..." Foreground="#60A5FA" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtSearchTimer" Text="Thời gian tìm: 00:05" Foreground="#93C5FD" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnFindMatch" Content="🔍 Tìm Trận Ngay" Style="{StaticResource ActionBtnStyle}" Margin="0,0,0,10" Click="BtnFindMatch_Click"/>
                        <Button x:Name="btnCancelFindMatch" Content="Hủy Tìm Trận" Background="#EF4444" Style="{StaticResource ActionBtnStyle}" Margin="0,0,0,10" Visibility="Collapsed" Click="BtnCancelFindMatch_Click"/>

                        <Separator Background="#262626" Margin="0,10,0,15"/>

                        <Button x:Name="btnPracticeAi" Content="🤖 Đấu Với AI (Luyện tập tức thì)" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" Foreground="#93C5FD" Style="{StaticResource ActionBtnStyle}" Click="BtnPracticeAi_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cột phải: Hướng dẫn luật PvP -->
                <Border Grid.Column="1" Background="#161616" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📜 Quy Luật Đấu Trường" Foreground="#FBBF24" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="• Hai người cùng giải 1 đề Sudoku giống hệt nhau trong thời gian thực." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="• Bàn cờ đối thủ được thu nhỏ và ẩn đáp án, chỉ hiển thị màu tiến độ." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="• Người giải xong trước toàn bộ bàn cờ sẽ giành CHIẾN THẮNG." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="• Phạm 3 lỗi (Mistakes) sẽ bị XỬ THUA trực tiếp (K.O)." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="• Thắng trận được cộng điểm Elo và tích lũy tỉ lệ thắng xếp hạng." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PANEL 2: PHÒNG RIÊNG (CUSTOM ROOM) -->
            <Grid x:Name="panelCustomRoom" Visibility="Collapsed">
                
                <!-- Khi chưa vào phòng: Tạo hoặc Tham gia phòng -->
                <Grid x:Name="subPanelRoomEntry" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Khung Tạo Phòng -->
                    <Border Grid.Column="0" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🏠 Tạo Phòng Mới" Foreground="#F3F4F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Sinh mã PIN 4 số và gửi cho bạn bè để cùng thi đấu." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Độ khó phòng:" Foreground="#D1D5DB" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbRoomDifficulty" SelectedIndex="1" Background="#262626" Foreground="#FFFFFF" Padding="8,6" Margin="0,0,0,20">
                                <ComboBoxItem Content="Dễ"/>
                                <ComboBoxItem Content="Trung bình"/>
                                <ComboBoxItem Content="Khó"/>
                                <ComboBoxItem Content="Chuyên gia"/>
                            </ComboBox>

                            <Button x:Name="btnCreateRoom" Content="Tạo Phòng &amp; Lấy Mã PIN" Style="{StaticResource ActionBtnStyle}" Click="BtnCreateRoom_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Khung Vào Phòng Bằng Mã PIN -->
                    <Border Grid.Column="1" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="25" Margin="10,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔑 Vào Phòng Bạn Bè" Foreground="#F3F4F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Nhập mã PIN phòng để ghép đôi với đối thủ." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Nhập mã PIN phòng (4 số):" Foreground="#D1D5DB" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtRoomPinInput" Height="42" MaxLength="6" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" Background="#262626" Foreground="#60A5FA" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,0,20"/>

                            <Button x:Name="btnJoinRoom" Content="Tham Gia Phòng" Style="{StaticResource ActionBtnStyle}" Click="BtnJoinRoom_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Khi đã ở trong phòng: Phòng chờ (Lobby Room View) -->
                <Border x:Name="subPanelInRoom" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="25" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Phòng: Mã PIN -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PHÒNG ĐẤU: " Foreground="#9CA3AF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRoomPinDisplay" Text="#8492" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <TextBlock x:Name="txtRoomDifficultyDisplay" Text="(Độ khó: Trung bình)" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Chia sẻ mã PIN này cho đối thủ của bạn!" Foreground="#60A5FA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Khung 2 Người Chơi -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Slot 1: Chủ phòng -->
                            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#1E3A8A" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtSlot1Avatar" Text="👤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtSlot1Name" Text="Chủ phòng" Foreground="#F3F4F6" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtSlot1Elo" Text="1250 Elo" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <Border x:Name="borderSlot1Ready" Background="#10B981" CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtSlot1Ready" Text="✓ SẴN SÀNG" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="VS" Foreground="#6B7280" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="20,0"/>

                            <!-- Slot 2: Khách -->
                            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#374151" BorderThickness="1.5" CornerRadius="10" Padding="20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#374151" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtSlot2Avatar" Text="❓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtSlot2Name" Text="Đang đợi người chơi..." Foreground="#9CA3AF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtSlot2Elo" Text="--- Elo" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <Border x:Name="borderSlot2Ready" Background="#374151" CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtSlot2Ready" Text="CHƯA SẴN SÀNG" Foreground="#9CA3AF" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Thanh nút hành động trong phòng -->
                        <Grid Grid.Row="2">
                            <Button x:Name="btnLeaveRoom" Content="🚪 Rời Phòng" Background="#374151" Foreground="#EF4444" Width="140" Height="42" HorizontalAlignment="Left" Style="{StaticResource ActionBtnStyle}" Click="BtnLeaveRoom_Click"/>
                            <Button x:Name="btnToggleReady" Content="Sẵn Sàng!" Background="#10B981" Width="180" Height="42" HorizontalAlignment="Right" Style="{StaticResource ActionBtnStyle}" Click="BtnToggleReady_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
